<nav class="topbar">
    <a class="brand" href="/">
        <span class="brandmark">S</span>
        <span>SPRITE<em>SCOUT</em></span>
    </a>
    <div class="navlinks">
        <a href="/#collection">Collection</a>
        <a href="/players">Find a player</a>
        @if (Profile is not null) { <a href="/tracked-players">Tracked players</a> }
    </div>
    <div class="headerActions">
        @if (IsAccountLoading)
        {
            <span class="signin" aria-label="Loading account">Loading...</span>
        }
        else if (Profile is null)
        {
            <a class="signin" href="auth/login?returnUrl=/"><span>↗</span> Sign in with Google</a>
        }
        else
        {
            <a class="signin" href="/account"><span>●</span> @Profile.DisplayName</a>
        }
        <details class="mobileMenu">
            <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
            <div class="mobileMenuPanel">
                @if (IsAccountLoading)
                {
                    <div class="mobileAccount"><strong>Loading account...</strong></div>
                }
                else if (Profile is not null)
                {
                    <a class="mobileAccount" href="/account"><span>●</span><strong>@Profile.DisplayName</strong></a>
                }
                <a href="/#collection">Collection <span>→</span></a>
                <a href="/players">Find a player <span>→</span></a>
                @if (Profile is not null) { <a href="/tracked-players">Tracked players <span>→</span></a> }
                @if (!IsAccountLoading && Profile is null)
                {
                    <a class="mobileSignIn" href="auth/login?returnUrl=/">Sign in with Google <span>↗</span></a>
                }
            </div>
        </details>
    </div>
</nav>

@code {
    [Parameter] public UserProfileDto? Profile { get; set; }
    [Parameter] public bool IsAccountLoading { get; set; }
}
