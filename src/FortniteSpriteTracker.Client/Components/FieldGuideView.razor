<div class="grid">
    @foreach (var sprite in Sprites)
    {
        var keys = sprite.Variants.Select(item => item.Id).ToArray();

        <article class="card @(keys.All(Mastered.Contains) ? "done" : "")">
            <div class="cardTop">
                <span class="rarity"><i style="background:@sprite.RarityColor"></i>@sprite.Rarity</span>
                <span class="variantProgress">@keys.Count(Owned.Contains) OWNED · @keys.Count(Mastered.Contains) MASTERED</span>
            </div>
            <div class="spriteVisual" style="--c1:@sprite.PrimaryColor">
                <img src="@sprite.ImageUrl" alt="@sprite.Name Sprite" loading="eager" />
            </div>
            <div class="cardBody">
                <h3>@sprite.Name <small>SPRITE</small></h3>
                <div class="ability">
                    <span>ABILITY</span>
                    <p>@sprite.Ability</p>
                </div>
                <div class="carouselLabel">
                    <span>VARIANTS · SWIPE TO EXPLORE</span>
                    <i>→</i>
                </div>
                <div class="variantCarousel" tabindex="0">
                    @foreach (var spriteVariant in sprite.Variants)
                    {
                        var isOwned = Owned.Contains(spriteVariant.Id);
                        var isMastered = Mastered.Contains(spriteVariant.Id);

                        <div class="variantTile @(isOwned ? "owned" : "") @(isMastered ? "mastered" : "")">
                            <span class="variantArt">
                                <img src="@spriteVariant.ImagePath" alt="@spriteVariant.Style.Name @sprite.Name Sprite" loading="eager" />
                            </span>
                            <span class="variantName"><i style="background:@spriteVariant.Style.Color"></i>@spriteVariant.Style.Name</span>
                            <small>@spriteVariant.Style.Bonus</small>
                            <div class="variantActions">
                                <button class="ownButton" disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => OwnedToggled.InvokeAsync(spriteVariant.Id)">@(isOwned ? "✓ Owned" : "+ Own")</button>
                                <button class="masterButton" disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => MasteredToggled.InvokeAsync(spriteVariant.Id)">@(isMastered ? "★ Mastered" : "☆ Master")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </article>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<SpriteFamilyDto> Sprites { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlySet<int> Owned { get; set; } = new HashSet<int>();
    [Parameter, EditorRequired] public IReadOnlySet<int> Mastered { get; set; } = new HashSet<int>();
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<int> OwnedToggled { get; set; }
    [Parameter] public EventCallback<int> MasteredToggled { get; set; }
    private string? ReadOnlyTitle => IsReadOnly ? "Collection tracking opens when this season starts." : null;
}
