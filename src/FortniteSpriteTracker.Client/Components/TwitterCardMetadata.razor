<meta name="twitter:card" content="@CardType" />
<meta name="twitter:url" content="@Metadata.CanonicalUrl" />
<meta name="twitter:title" content="@Metadata.Title" />
<meta name="twitter:description" content="@Metadata.Description" />

@if (Metadata.ImageUrl is not null)
{
    <meta name="twitter:image" content="@Metadata.ImageUrl" />
    <meta name="twitter:image:alt" content="@Metadata.ImageAlt" />
}

@code {
    [CascadingParameter] private PageMetadataContext? MetadataContext { get; set; }
    [Parameter] public string? Card { get; set; }

    private PageMetadataContext Metadata => MetadataContext
        ?? throw new InvalidOperationException($"{nameof(TwitterCardMetadata)} must be nested inside {nameof(PageMetadata)}.");
    private string CardType => Card ?? (Metadata.ImageUrl is null ? "summary" : "summary_large_image");
}
