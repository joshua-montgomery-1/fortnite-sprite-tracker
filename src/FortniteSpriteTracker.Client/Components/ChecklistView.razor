<div class="matrixWrap desktopChecklist">
    <table class="collectionMatrix">
        <thead>
            <tr>
                <th class="spriteColumn"><span>SPRITE FAMILY</span></th>
                @foreach (var style in Styles)
                {
                    <th>
                        <i style="background:@style.Color"></i>
                        <span>@style.Name</span>
                        <small>@style.Bonus</small>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var sprite in Sprites)
            {
                <tr>
                    <th class="spriteColumn" title="@sprite.Ability">
                        <img src="@sprite.ImageUrl" alt="" />
                        <span>
                            <strong>@sprite.Name</strong>
                            <small><i style="background:@sprite.RarityColor"></i>@sprite.Rarity</small>
                        </span>
                    </th>
                    @foreach (var style in Styles)
                    {
                        var spriteVariant = sprite.Variants.FirstOrDefault(item => item.Style.Id == style.Id);
                        if (spriteVariant is null)
                        {
                            <td class="unavailable"><span>—</span></td>
                        }
                        else
                        {
                            var isOwned = Owned.Contains(spriteVariant.Id);
                            var isMastered = Mastered.Contains(spriteVariant.Id);

                            <td class="@CellClass(isOwned, isMastered)">
                                <img src="@spriteVariant.ImagePath" alt="@style.Name @sprite.Name" loading="eager" />
                                <div>
                                    <button disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => OwnedToggled.InvokeAsync(spriteVariant.Id)">@(isOwned ? "✓" : "○")<small>OWN</small></button>
                                    <button disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => MasteredToggled.InvokeAsync(spriteVariant.Id)">@(isMastered ? "★" : "☆")<small>MASTER</small></button>
                                </div>
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mobileChecklist">
    @foreach (var sprite in Sprites)
    {
        <article class="mobileSpriteCard">
            <div class="mobileSpriteHeader">
                <img src="@sprite.ImageUrl" alt="@sprite.Name" />
                <div>
                    <strong>@sprite.Name</strong>
                    <small><i style="background:@sprite.RarityColor"></i>@sprite.Rarity</small>
                </div>
            </div>

            <div class="mobileVariantList">
                @foreach (var style in Styles)
                {
                    var spriteVariant = sprite.Variants.FirstOrDefault(item => item.Style.Id == style.Id);
                    if (spriteVariant is null)
                    {
                        continue;
                    }

                    var isOwned = Owned.Contains(spriteVariant.Id);
                    var isMastered = Mastered.Contains(spriteVariant.Id);

                    <div class="mobileVariantRow @CellClass(isOwned, isMastered)">
                        <div class="mobileVariantMeta">
                            <img src="@spriteVariant.ImagePath" alt="@style.Name @sprite.Name" loading="eager" />
                            <span>
                                <strong>@style.Name</strong>
                                <small>@style.Bonus</small>
                            </span>
                        </div>
                        <div class="mobileActionGroup">
                            <button class="@(isOwned ? "selected" : "")" disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => OwnedToggled.InvokeAsync(spriteVariant.Id)">
                                @(isOwned ? "Owned" : "Own")
                            </button>
                            <button class="@(isMastered ? "selected" : "")" disabled="@IsReadOnly" title="@ReadOnlyTitle" @onclick="() => MasteredToggled.InvokeAsync(spriteVariant.Id)">
                                @(isMastered ? "Mastered" : "Master")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </article>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<SpriteFamilyDto> Sprites { get; set; } = [];
    [Parameter, EditorRequired] public IEnumerable<VariantStyleDto> Styles { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlySet<int> Owned { get; set; } = new HashSet<int>();
    [Parameter, EditorRequired] public IReadOnlySet<int> Mastered { get; set; } = new HashSet<int>();
    [Parameter] public string Filter { get; set; } = "All";
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<int> OwnedToggled { get; set; }
    [Parameter] public EventCallback<int> MasteredToggled { get; set; }

    private string CellClass(bool isOwned, bool isMastered) =>
        $"{(isOwned ? "owned " : "")}{(isMastered ? "mastered " : "")}{(Filter == "Missing" && isOwned ? "collected" : "")}".TrimEnd();
    private string? ReadOnlyTitle => IsReadOnly ? "Collection tracking opens when this season starts." : null;
}
