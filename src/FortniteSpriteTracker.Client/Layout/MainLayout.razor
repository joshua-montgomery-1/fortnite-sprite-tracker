@inherits LayoutComponentBase
@inject AccountState AccountState
@inject ThemeService Theme
@Body

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AccountState.LoadAsync();
        }
        catch (HttpRequestException)
        {
            // Individual pages can retry and display their relevant connection error.
        }

        await Theme.InitializeAsync(AccountState.Profile?.ThemePreference);
    }
}
