@page "/terms"
@inject AccountState AccountState

<PageTitle>Terms of Service - Sprite Scout</PageTitle>
<HeadContent>
    <PageMetadata Title="Terms of Service - Sprite Scout"
                  Description="Read the terms governing use of Sprite Scout, the unofficial fan-made Fortnite Sprite collection tracker."
                  Path="/terms">
        <OpenGraphMetadata />
        <TwitterCardMetadata />
    </PageMetadata>
</HeadContent>

<main>
    <SiteHeader Profile="@AccountState.Profile" IsAccountLoading="@(!AccountState.IsLoaded)" />

    <section class="legalPage">
        <header class="legalHero">
            <span class="sectionKicker">LEGAL & POLICIES</span>
            <h1>TERMS OF SERVICE</h1>
            <p class="lastUpdated">Last updated: August 2026</p>
        </header>

        <div class="legalContent">
