@page "/"

<PageTitle>Sprite Scout - Fortnite Sprite Tracker</PageTitle>

<main class="@(printBlank ? "printBlank" : "")">
    <SiteHeader Profile="@profile" IsAccountLoading="@(!AccountState.IsLoaded)" />
    <HeroSection CubeHeroUrl="@CubeHeroUrl"
                 TotalEntries="@(catalog?.TotalEntries ?? 0)"
                 FamilyCount="@(catalog?.Families.Count ?? 0)"
                 Chapter="@(selectedSeason?.Chapter ?? 0)"
                 SeasonNumber="@(selectedSeason?.Number ?? 0)"
                 IsSeasonActive="@SelectedSeasonIsActive"
                 SeasonStatus="@SelectedSeasonStatus"
                 OnShowMissing="ShowMissing" />

    <div class="lowerPage">
    <section class="collection" id="collection">
        @if (profile is { IsProfileComplete: false })
        {
            <ProfileSetup Profile="@profile" ProfileSaved="SaveProfileAsync" />
        }

        @if (profile is null && showAnonymousWarning)
        {
            <aside class="syncNotice anonymousNotice" role="status">
                <div>
                    <strong>Saved on this device only</strong>
                    <span>Sign in to keep your Sprite collection available across devices.</span>
                </div>
                <a href="auth/login?returnUrl=%2F%23collection">Sign in with Google</a>
            </aside>
        }

        @if (profile is not null && showImportPrompt)
        {
            <aside class="syncNotice importNotice" role="status">
                <div>
                    <strong>Browser selections found</strong>
                    <span>Your database collection is shown below. Add selections made before sign-in without replacing existing saved progress?</span>
                </div>
                <div class="syncNoticeActions">
                    <button class="primary" disabled="@importingAnonymousProgress" @onclick="ImportAnonymousProgressAsync">
                        @(importingAnonymousProgress ? "Importing..." : "Import selections")
                    </button>
                    <button disabled="@importingAnonymousProgress" @onclick="DiscardAnonymousProgressAsync">Discard browser selections</button>
                </div>
            </aside>
        }

        @if (syncError is not null)
        {
            <aside class="syncNotice syncError" role="alert">
                <div>
                    <strong>Collection sync interrupted</strong>
                    <span>@syncError</span>
                </div>
            </aside>
        }

        <div class="collectionHead">
            <div>
                <div class="sectionKicker">YOUR FIELD GUIDE</div>
                <h2>SPRITE COLLECTION</h2>
                <p class="collectionIntro">Each available treatment is tracked separately. Missing cells are not part of that Sprite’s current in-game set.</p>
            </div>
            <label class="seasonSelect">
                SEASONS
                <select value="@selectedSeason?.Id" @onchange="SeasonChangedAsync">
                    @foreach (var season in seasons)
                    {
                        <option value="@season.Id">@season.Name</option>
                    }
                </select>
            </label>
        </div>

        @if (profile is not null && saveStatus is not null)
        {
            <div class="saveStatus @(saveStatus == "Saved" ? "saved" : "saving")" role="status" aria-live="polite">
                <span></span>@saveStatus
            </div>
        }

        <CollectionProgress OwnedCount="@owned.Count"
                            MasteredCount="@mastered.Count"
                            TotalEntries="@(catalog?.TotalEntries ?? 0)"
                            OwnedPercent="@OwnedPercent"
                            MasteredPercent="@MasteredPercent" />

        <div class="variantLegend">
            @foreach (var item in catalog?.VariantStyles ?? [])
            {
                <button class="@(variant == item.Name ? "active" : "")" @onclick="() => ToggleVariant(item)">
                    <i style="background:@item.Color"></i>
                    @item.Name
                    <small>@item.Bonus</small>
                </button>
            }
        </div>

        <div class="viewBar">
            <div>
                <span>COLLECTION VIEW</span>
                <p>@(viewMode == "Checklist" ? "Fast scan - every status at a glance" : "Detailed abilities and variant cards")</p>
            </div>
            <div class="viewActions">
                <div class="exportActions">
                    <button @onclick="() => PrintChecklist(false)"><b>⇩</b> My PDF</button>
                    <button @onclick="() => PrintChecklist(true)"><b>□</b> Blank PDF</button>
                </div>
                <div class="viewToggle">
                    <button class="@(viewMode == "Checklist" ? "selected" : "")" @onclick="ShowChecklist"><b>▦</b> Checklist</button>
                    <button class="@(viewMode == "Field Guide" ? "selected" : "")" @onclick="ShowFieldGuide"><b>▤</b> Field Guide</button>
                </div>
            </div>
        </div>

        <div class="filterbar">
            <div class="segmented">
                @foreach (var item in CollectionFilters)
                {
                    <button class="@(filter == item ? "selected" : "")" @onclick="() => filter = item">@item</button>
                }
            </div>
            <div class="filterRight">
                <label class="search">
                    <span>⌕</span>
                    <input @bind="query" @bind:event="oninput" placeholder="Search sprites" />
                </label>
                <select @bind="rarity">
                    <option>All</option>
                    <option>Rare</option>
                    <option>Epic</option>
                    <option>Legendary</option>
                    <option>Mythic</option>
                </select>
                <select @bind="variant">
                    <option>All</option>
                    @foreach (var item in catalog?.VariantStyles ?? [])
                    {
                        <option>@item.Name</option>
                    }
                </select>
            </div>
        </div>

        @if (catalogLoading)
        {
            <div class="playerState">Loading the current Sprite catalog...</div>
        }
        else if (catalogEmpty)
        {
            <div class="playerState"><strong>@catalogEmptyTitle</strong><span>@catalogEmptyMessage</span></div>
        }
        else if (catalogError is not null)
        {
            <aside class="syncNotice syncError" role="alert"><div><strong>Catalog unavailable</strong><span>@catalogError</span></div></aside>
        }
        else if (viewMode == "Checklist")
        {
            <ChecklistView Sprites="@VisibleSprites"
                           Styles="@ActiveStyles"
                           Owned="@owned"
                           Mastered="@mastered"
                           IsReadOnly="@SelectedSeasonIsUpcoming"
                           OwnedToggled="ToggleOwned"
                           MasteredToggled="ToggleMastered" />
        }
        else
        {
            <FieldGuideView Sprites="@VisibleSprites"
                            Owned="@owned"
                            Mastered="@mastered"
                            IsReadOnly="@SelectedSeasonIsUpcoming"
                            OwnedToggled="ToggleOwned"
                            MasteredToggled="ToggleMastered" />
        }
    </section>

        <FieldNotes />
        <SiteFooter />
    </div>
</main>
