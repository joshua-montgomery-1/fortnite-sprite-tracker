@page "/players"
@page "/players/{PublicId:guid}"

<PageTitle>@(data is null ? "Find a player" : $"{data.Player.DisplayName} ({data.Player.EpicDisplayName})") - Sprite Scout</PageTitle>

<main>
    <SiteHeader Profile="@AccountState.Profile" IsAccountLoading="@(!AccountState.IsLoaded)" />
    <section class="playerPage">
        <div class="playerSearchPanel">
            <div>
                <span class="sectionKicker">PLAYER LOOKUP</span>
                <h1>FIND A SPRITE SCOUT</h1>
                <p>Search by exact Epic display name. Player links use a permanent public ID, so they keep working if a username changes.</p>
            </div>
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label for="epic-search">EPIC DISPLAY NAME</label>
                <div>
                    <input id="epic-search" @bind="epicUsername" placeholder="Enter an Epic username" maxlength="16" />
                    <button class="primary" disabled="@searching">@(searching ? "Searching..." : "Find player")</button>
                </div>
                @if (searchMessage is not null)
                {
                    <span class="searchMessage" role="status">@searchMessage</span>
                }
            </form>
        </div>

        @if (searchResult is not null && PublicId is null)
        {
            <article class="playerSearchResult">
                <div><span class="sectionKicker">PLAYER FOUND</span><strong>@PlayerName(searchResult)</strong></div>
                <a class="primary" href="players/@searchResult.PublicId">View collection <span>→</span></a>
            </article>
        }

        @if (loading)
        {
            <div class="playerState">Loading this field guide...</div>
        }
        else if (catalogError is not null)
        {
            <div class="playerState"><strong>Catalog unavailable</strong><span>@catalogError</span></div>
        }
        else if (PublicId is not null && data is null)
        {
            <div class="playerState"><strong>Player not found</strong><span>This link may be invalid, or the player has not completed their Epic profile.</span></div>
        }
        else if (data is not null)
        {
            <header class="playerHero">
                <div>
                    <span class="sectionKicker">PUBLIC FIELD GUIDE</span>
                    <h2>@PlayerName(data.Player)</h2>
                    <p>
                        @if (data.Player.IsCollectionPublic)
                        {
                            <text>@data.Player.OwnedCount total sprites · @data.Player.MasteredCount mastered</text>
                        }
                    </p>
                </div>
                <div class="profileActions">
                    @if (data.Viewer is not null && !IsOwnProfile)
                    {
                        <button class="trackButton @(data.IsTracked ? "tracked" : "")" disabled="@changingTracking" @onclick="ToggleTrackingAsync">
                            @(changingTracking ? "Saving..." : data.IsTracked ? "Untrack" : "Track player")
                        </button>
                    }
                    <div class="shareBox">
                    <label>PERMANENT PLAYER LINK</label>
                    <div><input readonly value="@CanonicalUrl" /><button @onclick="CopyLinkAsync">@(copied ? "Copied" : "Copy")</button></div>
                    </div>
                </div>
            </header>

            @if (!data.Player.IsCollectionPublic)
            {
                <aside class="privateCollectionState">
                    <span class="sectionKicker">PRIVATE COLLECTION</span>
                    <strong>This user has made their collection private.</strong>
                    <p>Their Sprite totals, collection entries, and comparisons are not available.</p>
                </aside>
            }
            else if (IsOwnProfile)
            {
                <aside class="compareNotice">This is your public collection. Share the permanent link so another signed-in player can compare it with theirs.</aside>
            }
            else if (data.Viewer is null)
            {
                <aside class="compareNotice">Sign in to see exactly what @data.Player.EpicDisplayName has that you don't. <a href="@LoginUrl">Sign in with Google</a></aside>
            }
            else
            {
                <div class="comparisonSummary">
                    <div><strong>@TargetOnlyCount</strong><span>THEY HAVE, YOU DON'T</span></div>
                    <div><strong>@ViewerOnlyCount</strong><span>YOU HAVE, THEY DON'T</span></div>
                    <div><strong>@SharedCount</strong><span>OWNED BY BOTH</span></div>
                </div>
            }

            @if (data.Player.IsCollectionPublic)
            {
            <div class="playerToolbar">
                <div class="segmented">
                    <button class="@(mode == "collection" ? "selected" : "")" @onclick='() => mode = "collection"'>Their collection</button>
                    @if (data.Viewer is not null && !IsOwnProfile)
                    {
                        <button class="@(mode == "target" ? "selected" : "")" @onclick='() => mode = "target"'>They have, you don't</button>
                        <button class="@(mode == "viewer" ? "selected" : "")" @onclick='() => mode = "viewer"'>You have, they don't</button>
                        <button class="@(mode == "shared" ? "selected" : "")" @onclick='() => mode = "shared"'>Both</button>
                    }
                </div>
                <label class="search"><span>⌕</span><input @bind="collectionQuery" @bind:event="oninput" placeholder="Search this view" /></label>
            </div>

            <div class="publicCollectionGrid">
                @foreach (var entry in VisibleEntries)
                {
                    <article class="publicSpriteCard">
                        <div class="publicSpriteArt" style="--sprite-color:@entry.Family.PrimaryColor">
                            <img src="@entry.Variant.ImagePath" alt="@entry.Variant.Style.Name @entry.Family.Name Sprite" />
                        </div>
                        <div><span><i style="background:@entry.Variant.Style.Color"></i>@entry.Variant.Style.Name</span><h3>@entry.Family.Name</h3><small>@entry.Family.Rarity @(entry.IsMastered ? " · MASTERED" : "")</small></div>
                    </article>
                }
            </div>
            @if (!VisibleEntries.Any())
            {
                <div class="playerState"><strong>No sprites in this view</strong><span>Try another comparison tab or search.</span></div>
            }
            }
        }
    </section>
    <SiteFooter />
</main>
