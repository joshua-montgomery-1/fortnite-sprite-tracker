@page "/account"
@attribute [Authorize]

<PageTitle>Account - Sprite Scout</PageTitle>
<HeadContent>
    <PageMetadata Title="Account - Sprite Scout"
                  Description="Manage your Sprite Scout profile, collection privacy, theme, and account access."
                  Path="/account"
                  Robots="RobotsDirective.NoIndexNoFollow">
        <OpenGraphMetadata />
        <TwitterCardMetadata />
    </PageMetadata>
</HeadContent>

<main>
    <SiteHeader Profile="@AccountState.Profile" IsAccountLoading="@(!AccountState.IsLoaded)" />
    <section class="accountPage">
        @if (loading)
        {
            <div class="playerState">Loading your account...</div>
        }
        else if (profile is not null)
        {
            <header class="accountHero">
                <div>
                    <span class="sectionKicker">YOUR ACCOUNT</span>
                    <h1>SCOUT SETTINGS</h1>
                    <p>Manage your public identity, collection privacy, and account.</p>
                </div>
                <div class="accountStats" aria-label="Collection totals">
                    <div><strong>@ownedCount</strong><span>OWNED</span></div>
                    <div><strong>@masteredCount</strong><span>MASTERED</span></div>
                </div>
            </header>

            <div class="accountGrid">
                <section class="accountCard" aria-labelledby="profile-title">
                    <div class="accountCardHead">
                        <div><span class="sectionKicker">PROFILE</span><h2 id="profile-title">Your scout identity</h2></div>
                        @if (saveMessage is not null)
                        {
                            <span class="accountMessage @(saveSucceeded ? "success" : "error")" role="status">@saveMessage</span>
                        }
                    </div>
                    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <label>DISPLAY NAME<input maxlength="80" @bind="displayName" /></label>
                        <label>EPIC GAMES DISPLAY NAME<input minlength="3" maxlength="16" @bind="epicDisplayName" /></label>
                        <label class="privacySetting">
                            <input type="checkbox" @bind="isCollectionPublic" />
                            <span><strong>Public collection</strong><small>Allow other scouts to view your totals and Sprites and compare their collection with yours.</small></span>
                        </label>
                        <label class="themeSetting">
                            <span><strong>Theme</strong><small>System follows this device. Your selection is saved to your account.</small></span>
                            <select @bind="themePreference" @bind:after="PreviewThemeAsync" aria-label="Theme preference">
                                <option value="@ThemePreference.System">System</option>
                                <option value="@ThemePreference.Light">Light</option>
                                <option value="@ThemePreference.Dark">Dark</option>
                            </select>
                        </label>
                        <button class="primary" disabled="@saving">@(saving ? "Saving..." : "Save changes")</button>
                    </form>
                </section>

                <aside class="accountCard profileLinkCard">
                    <span class="sectionKicker">PLAYER PROFILE</span>
                    <h2>@(isCollectionPublic ? "Ready to share" : "Collection private")</h2>
                    <p>Your profile and Epic name remain discoverable. @(isCollectionPublic ? "Other scouts can view and compare your collection." : "Your totals, Sprites, and comparisons are hidden.")</p>
                    <label>PERMANENT PROFILE LINK</label>
                    <div class="accountLink"><input readonly value="@ProfileUrl" /><button @onclick="CopyLinkAsync">@(copied ? "Copied" : "Copy")</button></div>
                    <a href="@($"players/{profile.PublicId:D}")">View public profile <span>→</span></a>
                </aside>
            </div>

            <section class="accountCard accountAccess" aria-labelledby="access-title">
                <div><span class="sectionKicker">ACCESS</span><h2 id="access-title">Sign-in session</h2><p>Sign out on this device without changing your saved collection.</p></div>
                <button disabled="@busy" @onclick="LogoutAsync">Sign out</button>
            </section>

            <section class="accountCard dangerZone" aria-labelledby="danger-title">
                <div><span class="sectionKicker">DANGER ZONE</span><h2 id="danger-title">Delete account</h2><p>Permanently delete your profile and all saved collection progress. This cannot be undone.</p></div>
                <div class="deleteControl">
                    <label>TYPE DELETE TO CONFIRM<input @bind="deleteConfirmation" autocomplete="off" /></label>
                    <button disabled="@(busy || deleteConfirmation != "DELETE")" @onclick="DeleteAsync">@(deleting ? "Deleting..." : "Delete account")</button>
                    @if (deleteError is not null)
                    {
                        <span role="alert">@deleteError</span>
                    }
                </div>
            </section>
        }
    </section>
    <SiteFooter />
</main>
