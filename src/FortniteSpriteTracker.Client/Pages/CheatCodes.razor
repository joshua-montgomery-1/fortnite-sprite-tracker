@page "/cheat-codes"
@using FortniteSpriteTracker.Shared.CheatCodes

<PageTitle>@MetadataTitle</PageTitle>
<HeadContent>
    <PageMetadata Title="@MetadataTitle"
                  Description="@MetadataDescription"
                  Path="/cheat-codes">
        <OpenGraphMetadata />
        <TwitterCardMetadata />
        @if (catalog is not null)
        {
            <JsonLd Value="@CheatCodeStructuredData" />
        }
    </PageMetadata>
</HeadContent>

<main class="cheatCodePage">
    <SiteHeader Profile="@profile" IsAccountLoading="@(!AccountState.IsLoaded)" />
    <section class="cheatCodeContent">
        <div class="cheatCodeHero">
            <div>
                <span class="sectionKicker">@(catalog?.Season.Name.ToUpperInvariant() ?? "CURRENT FORTNITE SEASON")</span>
                <h1>LOBBY HACK CODES</h1>
                <p>Find every current Fortnite Lobby Hack code and reward, then track the one-time codes you have already claimed.</p>
            </div>
            @if (catalog is not null)
            {
                <div class="cheatSummary"><strong>@UsedCount / @catalog.TrackableCodeCount</strong><span>ONE-TIME CODES USED</span></div>
            }
        </div>

        <section class="cheatGuide" aria-labelledby="redeem-codes-title">
            <div>
                <span class="sectionKicker">HOW TO REDEEM</span>
                <h2 id="redeem-codes-title">How to use Fortnite Lobby Hack codes</h2>
            </div>
            <ol>
                <li>Open Fortnite and enter the Battle Royale lobby.</li>
                <li>Open the Admin Panel and choose the option to enter a Lobby Hack code.</li>
                <li>Type a code exactly as shown below, submit it, and claim the displayed reward.</li>
            </ol>
        </section>

        @if (catalogLoading)
        {
            <div class="playerState">Loading Lobby Hack codes...</div>
        }
        else if (catalog is null)
        {
            <div class="playerState"><strong>Lobby Hack archive unavailable</strong><span>Please try again later.</span></div>
        }
        else
        {
            <div class="codeFilters">
                <label class="categorySelect">
                    <span>CATEGORY</span>
                    <select @bind="selectedCategoryId" aria-label="Filter by reward category">
                        <option value="">All categories</option>
                    @foreach (var category in catalog.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                    </select>
                </label>
                <div class="segmented" aria-label="Filter by usage">
                    @foreach (var item in UsageFilters)
                    {
                        <button class="@(usageFilter == item ? "selected" : "")" @onclick="() => usageFilter = item">@item</button>
                    }
                </div>
            </div>

            <div class="codeTableWrap">
                <table class="codeTable">
                    <thead>
                        <tr><th>Category</th><th>Code</th><th>Reward</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var category in catalog.Categories.Where(item => selectedCategoryId is null || item.Id == selectedCategoryId))
                        {
                            @foreach (var cheat in category.Codes.Where(IsVisible))
                            {
                                var isUsed = usedIds.Contains(cheat.Id);
                                <tr class="@(isUsed ? "used" : "")">
                                    <td data-label="Category"><span class="categoryName">@category.Name</span></td>
                                    <td data-label="Code"><span class="cheatCodeValue">@cheat.Code</span></td>
                                    <td data-label="Reward">
                                        <div class="rewardDetails">
                                            <span>@cheat.Description</span>
                                            @if (!string.IsNullOrWhiteSpace(cheat.Requirement))
                                            {
                                                <small class="requirement"><b>Requirement</b>@cheat.Requirement</small>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Status" class="codeStatus">
                                        @if (!cheat.IsTrackable)
                                        {
                                            <span class="repeatable">Repeatable</span>
                                        }
                                        else
                                        {
                                            <button class="useToggle" disabled="@savingIds.Contains(cheat.Id)" @onclick="() => ToggleUsedAsync(cheat)">
                                                @(isUsed ? "Used" : "Mark used")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <section class="cheatFaq" aria-labelledby="cheat-faq-title">
            <span class="sectionKicker">QUICK ANSWERS</span>
            <h2 id="cheat-faq-title">Fortnite Lobby Hack code FAQ</h2>
            <div class="cheatFaqGrid">
                <article>
                    <h3>What do Lobby Hack codes unlock?</h3>
                    <p>Rewards can include Sprites, Sprite Dust, cosmetics, XP, Gizmos, supplies, and temporary lobby effects. The table above identifies each reward.</p>
                </article>
                <article>
                    <h3>Can every code be used more than once?</h3>
                    <p>No. Most rewards are one-time claims. Codes marked Repeatable can be entered again for their temporary effect.</p>
                </article>
                <article>
                    <h3>Does Sprite Scout redeem the codes?</h3>
                    <p>No. Redeem codes inside Fortnite. Sprite Scout only helps you find and track them alongside your <a href="/#collection">Sprite collection</a>.</p>
                </article>
            </div>
            <p class="cheatExplore">Want to compare progress? <a href="/players">Find another Sprite Scout player</a>.</p>
        </section>
    </section>
    <SiteFooter />
</main>
