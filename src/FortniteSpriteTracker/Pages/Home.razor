@page "/"
@using FortniteSpriteTracker.Models
@using FortniteSpriteTracker.Services
@inject BrowserStorage Storage
@inject BrowserPrintService Printer

<PageTitle>Sprite Scout - Fortnite Sprite Tracker</PageTitle>

<main class="@(printBlank ? "printBlank" : "")">
    <nav class="topbar">
        <a class="brand" href="#top">
            <span class="brandmark">S</span>
            <span>SPRITE<em>SCOUT</em></span>
        </a>
        <div class="navlinks">
            <a class="active" href="#collection">Collection</a>
            <a href="#field-notes">Field notes</a>
        </div>
        <button class="signin"><span>↗</span> Sign in <small>SOON</small></button>
    </nav>

    <section class="hero" id="top">
        <div class="parallaxGrid"></div>
        <div class="heroCopy">
            <div class="eyebrow"><span class="liveDot"></span> LIVE SEASON · CHAPTER 7</div>
            <h1>KNOW YOUR<br /><span>SPRITES.</span></h1>
            <p>Track every companion and every real variant. Learn their powers, fill your field guide, and know exactly what to hunt next.</p>
            <div class="heroActions">
                <a class="primary" href="#collection">Track @SpriteData.TotalEntries entries <span>↓</span></a>
                <button class="textButton" @onclick="ShowMissing">Show what’s missing <span>→</span></button>
            </div>
        </div>
        <div class="heroArt">
            <div class="orbit orbitOne"></div>
            <div class="orbit orbitTwo"></div>
            <div class="rareSpriteGlow"></div>
            <img class="rareSprite" src="@CubeHeroUrl" alt="Rare Cube Zero Point Sprite" />
            <div class="rareLabel">
                <small>RARE FIND</small>
                <strong>CUBE ZERO POINT</strong>
                <span>Storm Overdrive variant</span>
            </div>
            <div class="seasonTag">
                <small>FIELD GUIDE</small>
                <strong>@SpriteData.Sprites.Length FAMILIES</strong>
                <span>@SpriteData.TotalEntries valid variants</span>
            </div>
        </div>
    </section>

    <section class="collection" id="collection">
        <div class="collectionHead">
            <div>
                <div class="sectionKicker">YOUR FIELD GUIDE</div>
                <h2>SPRITE COLLECTION</h2>
                <p class="collectionIntro">Each available treatment is tracked separately. Missing cells are not part of that Sprite’s current in-game set.</p>
            </div>
            <label class="seasonSelect">
                CURRENT SEASON
                <select>
                    <option>Chapter 7 · Season 3</option>
                </select>
            </label>
        </div>

        <div class="progressPanel">
            <div class="progressNumbers">
                <div class="progressNumber ownedTotal">
                    <strong>@owned.Count</strong>
                    <span>/ @SpriteData.TotalEntries<small>OWNED</small></span>
                </div>
                <div class="progressNumber">
                    <strong>@mastered.Count</strong>
                    <span>/ @SpriteData.TotalEntries<small>MASTERED</small></span>
                </div>
            </div>
            <div class="dualTracks">
                <div class="trackRow">
                    <span>OWNED · @OwnedPercent%</span>
                    <div class="progressTrack ownedTrack"><div style="width:@OwnedPercent%"></div></div>
                </div>
                <div class="trackRow">
                    <span>MASTERED · @MasteredPercent%</span>
                    <div class="progressTrack"><div style="width:@MasteredPercent%"></div></div>
                </div>
            </div>
        </div>

        <div class="variantLegend">
            @foreach (var item in SpriteData.AllVariants)
            {
                <button class="@(variant == item.ToString() ? "active" : "")" @onclick="() => ToggleVariant(item)">
                    <i style="background:@SpriteData.Variants[item].Color"></i>
                    @item
                    <small>@SpriteData.Variants[item].Bonus</small>
                </button>
            }
        </div>

        <div class="viewBar">
            <div>
                <span>COLLECTION VIEW</span>
                <p>@(viewMode == "Checklist" ? "Fast scan - every status at a glance" : "Detailed artwork, abilities, and variant cards")</p>
            </div>
            <div class="viewActions">
                <div class="exportActions">
                    <button @onclick="() => PrintChecklist(false)"><b>⇩</b> My PDF</button>
                    <button @onclick="() => PrintChecklist(true)"><b>□</b> Blank PDF</button>
                </div>
                <div class="viewToggle">
                    <button class="@(viewMode == "Checklist" ? "selected" : "")" @onclick="ShowChecklist"><b>▦</b> Checklist</button>
                    <button class="@(viewMode == "Field Guide" ? "selected" : "")" @onclick="ShowFieldGuide"><b>▤</b> Field Guide</button>
                </div>
            </div>
        </div>

        <div class="filterbar">
            <div class="segmented">
                @foreach (var item in CollectionFilters)
                {
                    <button class="@(filter == item ? "selected" : "")" @onclick="() => filter = item">@item</button>
                }
            </div>
            <div class="filterRight">
                <label class="search">
                    <span>⌕</span>
                    <input @bind="query" @bind:event="oninput" placeholder="Search sprites" />
                </label>
                <select @bind="rarity">
                    <option>All</option>
                    <option>Rare</option>
                    <option>Epic</option>
                    <option>Legendary</option>
                    <option>Mythic</option>
                </select>
                <select @bind="variant">
                    <option>All</option>
                    @foreach (var item in SpriteData.AllVariants)
                    {
                        <option>@item</option>
                    }
                </select>
            </div>
        </div>

        @if (viewMode == "Checklist")
        {
            <div class="matrixWrap">
                <table class="collectionMatrix">
                    <thead>
                        <tr>
                            <th class="spriteColumn"><span>SPRITE FAMILY</span></th>
                            @foreach (var item in ActiveVariants)
                            {
                                <th>
                                    <i style="background:@SpriteData.Variants[item].Color"></i>
                                    <span>@item</span>
                                    <small>@SpriteData.Variants[item].Bonus</small>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sprite in VisibleSprites)
                        {
                            <tr>
                                <th class="spriteColumn" title="@sprite.Ability">
                                    <img src="@SpriteData.ImageUrl(sprite.Slug)" alt="" />
                                    <span>
                                        <strong>@sprite.Name</strong>
                                        <small><i style="background:@SpriteData.RarityColors[sprite.Rarity]"></i>@sprite.Rarity</small>
                                    </span>
                                </th>
                                @foreach (var item in ActiveVariants)
                                {
                                    if (!sprite.Variants.Contains(item))
                                    {
                                        <td class="unavailable"><span>—</span></td>
                                    }
                                    else
                                    {
                                        var key = SpriteData.Key(sprite.Name, item);
                                        var hasOwned = owned.Contains(key);
                                        var isMastered = mastered.Contains(key);

                                        <td class="@CellClass(hasOwned, isMastered)">
                                            <img src="@SpriteData.VariantImageUrl(sprite.Slug, item)" alt="@item @sprite.Name" loading="eager" />
                                            <div>
                                                <button @onclick="() => ToggleOwned(key)">@(hasOwned ? "✓" : "○")<small>OWN</small></button>
                                                <button @onclick="() => ToggleMastered(key)">@(isMastered ? "★" : "☆")<small>MASTER</small></button>
                                            </div>
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var sprite in VisibleSprites)
                {
                    var keys = sprite.Variants.Select(item => SpriteData.Key(sprite.Name, item)).ToArray();

                    <article class="card @(keys.All(mastered.Contains) ? "done" : "")">
                        <div class="cardTop">
                            <span class="rarity"><i style="background:@SpriteData.RarityColors[sprite.Rarity]"></i>@sprite.Rarity</span>
                            <span class="variantProgress">@keys.Count(owned.Contains) OWNED · @keys.Count(mastered.Contains) MASTERED</span>
                        </div>
                        <div class="spriteVisual" style="--c1:@sprite.PrimaryColor">
                            <img src="@SpriteData.ImageUrl(sprite.Slug)" alt="@sprite.Name Sprite" loading="eager" />
                            <span class="imageCredit">COMMUNITY ARTWORK</span>
                        </div>
                        <div class="cardBody">
                            <h3>@sprite.Name <small>SPRITE</small></h3>
                            <div class="ability">
                                <span>ABILITY</span>
                                <p>@sprite.Ability</p>
                            </div>
                            <div class="carouselLabel">
                                <span>VARIANTS · SWIPE TO EXPLORE</span>
                                <i>→</i>
                            </div>
                            <div class="variantCarousel" tabindex="0">
                                @foreach (var item in sprite.Variants)
                                {
                                    var key = SpriteData.Key(sprite.Name, item);
                                    var hasOwned = owned.Contains(key);
                                    var isMastered = mastered.Contains(key);

                                    <div class="variantTile @(hasOwned ? "owned" : "") @(isMastered ? "mastered" : "")">
                                        <span class="variantArt">
                                            <img src="@SpriteData.VariantImageUrl(sprite.Slug, item)" alt="@item @sprite.Name Sprite" loading="eager" />
                                        </span>
                                        <span class="variantName"><i style="background:@SpriteData.Variants[item].Color"></i>@item</span>
                                        <small>@SpriteData.Variants[item].Bonus</small>
                                        <div class="variantActions">
                                            <button class="ownButton" @onclick="() => ToggleOwned(key)">@(hasOwned ? "✓ Owned" : "+ Own")</button>
                                            <button class="masterButton" @onclick="() => ToggleMastered(key)">@(isMastered ? "★ Mastered" : "☆ Master")</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="notes" id="field-notes">
        <div>
            <div class="sectionKicker">VARIANT INTEL</div>
            <h2>EVERY FINISH COUNTS.</h2>
        </div>
        <p>Variants retain their Sprite’s core ability and add a separate bonus. The field guide only shows confirmed treatments for each family.</p>
        <a href="https://fortnitespritetracker.org/" target="_blank">Artwork &amp; variant reference ↗</a>
    </section>

    <footer>
        <div class="brand">
            <span class="brandmark">S</span>
            <span>SPRITE<em>SCOUT</em></span>
        </div>
        <p>Unofficial fan-made companion. Progress stays in this browser.</p>
        <span>.NET 10 · BLAZOR WEBASSEMBLY</span>
    </footer>
</main>

@code {
    private static readonly string[] CollectionFilters = ["All", "Owned", "Missing", "Mastered"];
    private readonly HashSet<string> owned = [];
    private readonly HashSet<string> mastered = [];

    private string filter = "All";
    private string rarity = "All";
    private string variant = "All";
    private string query = "";
    private string viewMode = "Checklist";
    private bool printBlank;

    private string CubeHeroUrl => SpriteData.VariantImageUrl("zeropoint", SpriteVariant.Cube);

    private int OwnedPercent => (int)Math.Round(owned.Count * 100d / SpriteData.TotalEntries);

    private int MasteredPercent => (int)Math.Round(mastered.Count * 100d / SpriteData.TotalEntries);

    private IEnumerable<SpriteVariant> ActiveVariants =>
        variant == "All"
            ? SpriteData.AllVariants
            : [Enum.Parse<SpriteVariant>(variant)];

    private IEnumerable<SpriteDefinition> VisibleSprites => SpriteData.Sprites.Where(SpriteIsVisible);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var savedOwned = await Storage.GetAsync("sprite-scout-owned", Array.Empty<string>());
        var savedMastered = await Storage.GetAsync("sprite-scout-mastered", Array.Empty<string>());

        owned.UnionWith(savedOwned);
        mastered.UnionWith(savedMastered);
        owned.UnionWith(mastered);
        StateHasChanged();
    }

    private bool SpriteIsVisible(SpriteDefinition sprite)
    {
        var matchesStatus = filter switch
        {
            "Owned" => sprite.Variants.Any(item => owned.Contains(SpriteData.Key(sprite.Name, item))),
            "Missing" => sprite.Variants.Any(item => !owned.Contains(SpriteData.Key(sprite.Name, item))),
            "Mastered" => sprite.Variants.Any(item => mastered.Contains(SpriteData.Key(sprite.Name, item))),
            _ => true
        };

        var matchesRarity = rarity == "All" || sprite.Rarity.ToString() == rarity;
        var matchesVariant = variant == "All" || sprite.Variants.Contains(Enum.Parse<SpriteVariant>(variant));
        var matchesQuery = $"{sprite.Name} {sprite.Ability}".Contains(query, StringComparison.OrdinalIgnoreCase);

        return matchesStatus && matchesRarity && matchesVariant && matchesQuery;
    }

    private static string CellClass(bool hasOwned, bool isMastered) =>
        $"{(hasOwned ? "owned " : "")}{(isMastered ? "mastered" : "")}";

    private async Task SaveAsync()
    {
        await Storage.SetAsync("sprite-scout-owned", owned);
        await Storage.SetAsync("sprite-scout-mastered", mastered);
    }

    private async Task ToggleOwned(string key)
    {
        if (!owned.Remove(key))
        {
            owned.Add(key);
        }
        else
        {
            mastered.Remove(key);
        }

        await SaveAsync();
    }

    private async Task ToggleMastered(string key)
    {
        if (!mastered.Remove(key))
        {
            mastered.Add(key);
            owned.Add(key);
        }

        await SaveAsync();
    }

    private void ShowMissing() => filter = "Missing";

    private void ToggleVariant(SpriteVariant item) =>
        variant = variant == item.ToString() ? "All" : item.ToString();

    private void ShowChecklist() => viewMode = "Checklist";

    private void ShowFieldGuide() => viewMode = "Field Guide";

    private async Task PrintChecklist(bool blank)
    {
        var previousState = (viewMode, filter, rarity, variant, query);

        printBlank = blank;
        viewMode = "Checklist";
        filter = "All";
        rarity = "All";
        variant = "All";
        query = "";
        StateHasChanged();

        await Task.Delay(350);
        await Printer.PrintAsync();

        printBlank = false;
        (viewMode, filter, rarity, variant, query) = previousState;
    }
}
