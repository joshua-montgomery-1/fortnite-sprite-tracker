@using Microsoft.AspNetCore.Components.Routing
@using SpriteScout.Auth
@using FortniteSpriteTracker.Components.Auth
@inject AuthPagePresentation AuthPagePresentation
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Site-wide Meta Tags -->
    <meta name="author" content="Sprite Scout" />
    <meta name="theme-color" content="#131722" />
    <meta name="google-adsense-account" content="ca-pub-2749846781014788">

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    @if (!IsAuthPage)
    {
        <ResourcePreloader />
    }
    <script nonce="@AuthPagePresentation.Nonce">
        (() => {
            const key = "sprite-scout-theme-preference";
            let preference = "system";

            try {
                const stored = localStorage.getItem(key);
                if (stored) preference = JSON.parse(stored);
            } catch {
                // Storage can be unavailable in privacy-restricted browsing contexts.
            }

            if (!["system", "light", "dark"].includes(preference)) preference = "system";
            document.documentElement.dataset.themePreference = preference;
            document.documentElement.dataset.theme = preference === "system"
                ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                : preference;
        })();
    </script>
    <link rel="stylesheet" href="@($"/{Assets["css/app.css"].TrimStart('/')}")" />
    <link rel="stylesheet" href="@($"/{Assets["FortniteSpriteTracker.styles.css"].TrimStart('/')}")" />
    @if (!IsAuthPage)
    {
        <ImportMap />
    }
    else
    {
        <link rel="stylesheet" href="/css/auth.css" />
        <style nonce="@AuthPagePresentation.Nonce">@AuthPagePresentation.SpriteStyles</style>
    }
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="@(IsAuthPage ? "auth-page" : null)">
    @if (AuthPage is not null)
    {
        <LayoutView Layout="typeof(AuthLayout)"><AuthCard Model="AuthPage" /></LayoutView>
    }
    else if (IsAuthPage)
    {
        <AuthRoutes />
    }
    else
    {
        <Routes @rendermode="PageRenderMode" />
    }

    @if (!IsAuthPage)
    {
        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">×</span>
        </div>
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Parameter] public AuthPageModel? AuthPage { get; set; }
    [Parameter] public string? AuthRedirect { get; set; }

    private bool IsAuthPage => AuthPage is not null ||
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<AuthUiAttribute>() is not null;
    private IComponentRenderMode? PageRenderMode => IsAuthPage || !HttpContext.AcceptsInteractiveRouting()
        ? null : InteractiveWebAssembly;

    protected override async Task OnInitializedAsync()
    {
        if (IsAuthPage) await AuthPagePresentation.InitializeAsync(HttpContext, AuthRedirect);
    }
}
