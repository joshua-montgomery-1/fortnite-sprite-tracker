<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="Sprite Scout - Fortnite Sprite Tracker & Field Guide" />
    <meta name="description" content="Track, scout, and complete your Fortnite Sprite collections across chapters and seasons. Compare collections with friends and track sprite progress in real time on Sprite Scout." />
    <meta name="keywords" content="Fortnite, Sprite Scout, Fortnite Sprites, Fortnite Sprite Tracker, Sprite Checklist, Chapter 6 Sprites, Fortnite Collectibles, Fortnite Companion Tracker" />
    <meta name="author" content="Sprite Scout" />
    <meta name="theme-color" content="#131722" />
    <meta name="google-adsense-account" content="ca-pub-2749846781014788">
    <link rel="canonical" href="https://spritescout.com/" />

    <!-- Open Graph / Facebook / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sprite Scout" />
    <meta property="og:url" content="https://spritescout.com/" />
    <meta property="og:title" content="Sprite Scout - Fortnite Sprite Tracker & Field Guide" />
    <meta property="og:description" content="Track, scout, and complete your Fortnite Sprite collections across chapters and seasons. Compare collections with friends and track sprite progress in real time on Sprite Scout." />
    <meta property="og:image" content="https://spritescout.com/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sprite Scout - Fortnite Sprite Tracker & Field Guide" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://spritescout.com/" />
    <meta name="twitter:title" content="Sprite Scout - Fortnite Sprite Tracker & Field Guide" />
    <meta name="twitter:description" content="Track, scout, and complete your Fortnite Sprite collections across chapters and seasons. Compare collections with friends and track sprite progress in real time on Sprite Scout." />
    <meta name="twitter:image" content="https://spritescout.com/images/og-image.png" />
    <meta name="twitter:image:alt" content="Sprite Scout - Fortnite Sprite Tracker & Field Guide" />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="favicon.png" />
    <link rel="manifest" href="site.webmanifest" />

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["FortniteSpriteTracker.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <Routes @rendermode="InteractiveWebAssembly" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">×</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
