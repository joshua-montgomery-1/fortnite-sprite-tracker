@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>@Model.Title</PageTitle>
    <main class="auth-card" aria-labelledby="page-heading">
        <div class="kicker">YOUR SPRITE SCOUT ACCOUNT</div>
        <h1 id="page-heading">@Model.Heading</h1>
        @switch (Model.Kind)
        {
            case AuthPageKind.WebsiteLogin:
                <p class="intro">Keep your field guide close. Sign in to save your Sprite collection and pick up where you left off, on any device.</p>
                break;
            case AuthPageKind.Login:
                <p class="intro">
                    @if (Model.Application is null)
                    {
                        <text>Your Sprite Scout account starts here.</text>
                    }
                    else
                    {
                        <text>Sign in to connect Sprite Scout to <strong>@Model.Application</strong>.</text>
                    }
                </p>
                break;
            case AuthPageKind.Consent:
                <p class="intro"><strong>@Model.Application</strong> wants to connect to your Sprite Scout account.</p>
                break;
            case AuthPageKind.Error:
                <p class="intro" role="alert">
                    @(Model.Expired ? "The consent form expired. Start sign-in again." : "Google sign-in couldn't be completed. Your connection hasn't been approved.")
                </p>
                <a class="button" href="@Model.Retry">Try again</a>
                break;
            case AuthPageKind.SignedIn:
                <p class="intro">Return to the application you want to connect to Sprite Scout. You'll review its permissions before granting access.</p>
                break;
        }
        @if (Model.Form is not null)
        {
            <AuthForm Model="Model.Form" CollectionRead="Model.CollectionRead" CollectionWrite="Model.CollectionWrite"
                      AccountWrite="Model.AccountWrite" Offline="Model.Offline" />
        }
        @if (Model.Kind is AuthPageKind.Login or AuthPageKind.WebsiteLogin)
        {
            @if (!Model.Available)
            {
                <p class="notice" role="status">Sign-in is unavailable right now. Please try again later.</p>
            }
            else if (Model.Kind == AuthPageKind.WebsiteLogin)
            {
                <p class="note">A free account. Your collection, wherever you play.</p>
            }
            else
            {
                <p class="note">Use your Google account to sign in or create a free Sprite Scout account. You'll review permissions before connecting an application.</p>
            }
        }
    </main>

@code {
    [Parameter, EditorRequired] public AuthPageModel Model { get; set; } = default!;
}
