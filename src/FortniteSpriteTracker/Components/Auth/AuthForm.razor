@using Microsoft.AspNetCore.Components

<form method="post" action="@Model.Action" data-enhance="false">
    @foreach (var field in Model.Fields)
    {
        <input type="hidden" name="@field.Name" value="@field.Value" />
    }
    @if (Model.Consent)
    {
        @if (CollectionRead || CollectionWrite)
        {
            <fieldset class="consent-permissions">
                <legend>Collection</legend>
                @if (CollectionRead)
                {
                    <label class="consent-permission">
                        <input type="checkbox" name="approved_scope" value="@AuthDefaults.CollectionReadScope" checked />
                        <span><strong>Read</strong><small>See which Sprites you own and have mastered.</small></span>
                    </label>
                }
                @if (CollectionWrite)
                {
                    <label class="consent-permission">
                        <input type="checkbox" name="approved_scope" value="@AuthDefaults.CollectionWriteScope" checked />
                        <span><strong>Write</strong><small>Mark Sprites owned, unowned, mastered, or unmastered. Removing ownership also clears mastery.</small></span>
                    </label>
                }
            </fieldset>
        }
        <fieldset class="consent-permissions">
            <legend>Profile &amp; account</legend>
            <label class="consent-permission">
                <input type="checkbox" checked disabled />
                <span><strong>Read <span class="required-permission">Required</span></strong>
                    <small>Read your display name, Epic Games display name, public profile identifier, and profile settings.</small></span>
            </label>
            <input type="hidden" name="approved_scope" value="@AuthDefaults.AccountReadScope" />
            @if (AccountWrite)
            {
                <label class="consent-permission">
                    <input type="checkbox" name="approved_scope" value="@AuthDefaults.AccountWriteScope" checked />
                    <span><strong>Write</strong><small>Edit your display name and Epic Games display name.</small></span>
                </label>
            }
        </fieldset>
        @if (Offline)
        {
            <fieldset class="consent-permissions">
                <legend>Connection</legend>
                <label class="consent-permission">
                    <input type="checkbox" name="approved_scope" value="@OpenIddict.Abstractions.OpenIddictConstants.Scopes.OfflineAccess" checked />
                    <span><strong>Keep me signed in</strong><small>Allow this application to renew access for up to 30 days without asking you to sign in again.</small></span>
                </label>
            </fieldset>
        }
        <p class="consent-note">Uncheck any optional permission. Features needing that permission will be unavailable.</p>
        <button name="decision" value="allow">Allow connection</button>
        <button class="secondary" name="decision" value="deny">Cancel</button>
    }
    else
    {
        <button name="decision" value="signin">Continue with Google <span aria-hidden="true">↗</span></button>
    }
</form>

@code {
    [Parameter, EditorRequired] public AuthFormModel Model { get; set; } = default!;
    [Parameter] public bool CollectionRead { get; set; }
    [Parameter] public bool CollectionWrite { get; set; }
    [Parameter] public bool AccountWrite { get; set; }
    [Parameter] public bool Offline { get; set; }
}
